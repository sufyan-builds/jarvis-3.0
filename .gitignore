# Environment variables & secrets (NEVER commit real keys)
.env
.env.*
!.env.example

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# User-generated code outputs (keep folder structure only)
generated_code/*
!generated_code/.gitkeep

# Temporary / editor runner files
tempCodeRunnerFile.*
*.log
*.tmp

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

