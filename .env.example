# Copy this file to .env and fill in your real values.

# Get a free key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Keep the model configurable so switching models later is easy.
GROQ_MODEL=llama-3.1-70b-versatile
AI_PROVIDER=groq
AI_TEMPERATURE=0.4

# How many recent back-and-forth turns Jarvis remembers for follow-up questions.
MAX_MEMORY_TURNS=6

# Words that wake Jarvis up in jarvis.py's hands-free loop, comma separated.
WAKE_WORDS=hey jarvis,jarvis

# Set to true to use local, offline Faster-Whisper speech recognition instead
# of Google's online recognizer. Requires: pip install faster-whisper
# Recommended for better multilingual recognition when the package is installed.
USE_FASTER_WHISPER=true
WHISPER_MODEL_SIZE=base.en
SLEEP_AFTER_SECONDS=300
